{
  "name": "ucl-project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "UEFA Champions League SPA built with React, TypeScript, Vite and Tailwind CSS",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node -e \"require('fs').mkdirSync('reports/vitest',{recursive:true})\" && vitest run",
    "test:watch": "node -e \"require('fs').mkdirSync('reports/vitest',{recursive:true})\" && vitest",
    "test:coverage": "node -e \"require('fs').mkdirSync('reports/vitest',{recursive:true})\" && vitest run --coverage",
    "test:e2e": "node -e \"require('fs').mkdirSync('reports/playwright',{recursive:true})\" && playwright test",
    "test:e2e:ui": "node -e \"require('fs').mkdirSync('reports/playwright',{recursive:true})\" && playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "msw": "^2.11.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
